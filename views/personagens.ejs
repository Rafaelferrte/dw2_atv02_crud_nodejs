<%- include("partials/header") %>

<section class="pagina-categoria">
    <div class="titulo-pagina">
        <p class="subtitulo">A Sociedade do Anel</p>
        <h1>Personagens</h1>
        <p>
            Conheça alguns dos personagens que participaram da jornada
            pela Terra-média.
        </p>
    </div>

    <div class="formularios-cadastro">
        <section class="formulario-container">
            <h2>Cadastrar personagens</h2>

            <form class="formulario-cadastro" action="/personagens/cadastrar" method="POST">
                <div class="campo">
                    <label for="nome">Nome</label>
                    <input type="text" name="nome" id="nome" required>
                </div>

                <div class="campo">
                    <label for="raca">Raça</label>
                    <input type="text" name="raca" id="raca" required>
                </div>

                <div class="campo">
                    <label for="origem">Origem</label>
                    <input type="text" name="origem" id="origem" required>
                </div>

                <div class="campo">
                    <label for="papel">Papel</label>
                    <input type="text" name="papel" id="papel" required>
                </div>

                <div class="botoes-formulario">
                    <button type="submit" class="btn-cadastrar">Cadastrar</button>
                    <button type="reset" class="btn-limpar">Limpar</button>
                </div>
            </form>
        </section>
    </div>

    <br>
    <br>
    <div class="tabela-container">
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Raça</th>
                    <th>Origem</th>
                    <th>Papel</th>
                     <!-- COluna de ações -->
                    <th  colspan="2">Ações</th>
                </tr>
            </thead>

            <tbody>
                <% personagens.forEach(function (personagem) { %>
                    <tr>
                        <td><%= personagem.nome %></td>
                        <td><%= personagem.raca %></td>
                        <td><%= personagem.origem %></td>
                        <td><%= personagem.papel %></td>
                        <!-- Botão de editar -->
                        <td>
                            <a href="/personagens/editar/<%= personagem.id %>" style=" text-decoration: none;">Editar</a>
                        </td>
                        <!-- Botãoi excluir -->
                        <td>
                            <a href="/personagens/excluir/<%= personagem.id %>" style=" text-decoration: none;" onclick="return confirm('Deseja mesmo excluir o personagem <%= personagem.nome %>')">Excluir</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</section>

<%- include("partials/footer") %>