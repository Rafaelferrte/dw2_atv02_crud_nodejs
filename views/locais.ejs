<%- include("partials/header") %>

<section class="pagina-categoria">
    <div class="titulo-pagina">
        <p class="subtitulo">Explore o mapa</p>
        <h1>Locais da Terra-média</h1>
        <p>
            Descubra alguns dos territórios mais importantes dessa história.
        </p>
    </div>

    <div class="formularios-cadastro">

        <section class="formulario-container">
            <h2>Cadastrar locais</h2>
    
            <form class="formulario-cadastro" action="/locais/cadastrar" method="POST">
                <div class="campo">
                    <label for="local">Local</label>
                    <input type="text" name="local" id="local" required>
                </div>

                <div class="campo">
                    <label for="regiao">Região</label>
                    <input type="text" name="regiao" id="regiao" required>
                </div>

                <div class="campo">
                    <label for="habitantes">Habitantes</label>
                    <input type="text" name="habitantes" id="habitantes" required>
                </div>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <textarea name="descricao" id="descricao" rows="4" required></textarea>
                </div>

                <div class="botoes-formulario">
                    <button type="submit" class="btn-cadastrar">Cadastrar</button>
                    <button type="reset" class="btn-limpar">Limpar</button>
                </div>
            </form>
        </section>
    </div>
    <br>
    <br>

    <div class="tabela-container">
        <table>
            <thead>
                <tr>
                    <th>Local</th>
                    <th>Região</th>
                    <th>Habitantes</th>
                    <th>Descrição</th>
                </tr>
            </thead>

            <tbody>
                <% locais.forEach(function (local) { %>
                    <tr>
                        <td><%= local.local %></td>
                        <td><%= local.regiao %></td>
                        <td><%= local.habitantes %></td>
                        <td><%= local.descricao %></td>
                        <!-- Botão de editar -->
                        <td>
                            <a href="/locais/editar/<%= local.id %>" class="btn btn-warning">Editar</a>
                        </td>
                        <!-- Botãoi excluir -->
                        <td>
                            <a href="/locais/excluir/<%= local.id %>" class="btn btn-danger" onclick="return confirm('Deseja mesmo excluir o local <%= locais.local %>')">Excluir</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <div class="container-img">
        <img src="/images/terra-media.webp" alt="Imagem da Terra Média" class="img-mapa">
    </div>
</section>

<%- include("partials/footer") %>