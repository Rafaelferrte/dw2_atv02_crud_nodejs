<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h1>Editar cliente</h1>
            <hr>
        </div>
        <div class="card-body">
            <form action="/personagens/alterar" method="POST">
                <label for="nome">Nome do cliente</label>
                <input type="text" name="nome" id="nome" class="form-control" required value="<%= cliente.nome%>">
                <label for="cpf">CPF do cliente</label>
                <input type="text" name="cpf" id="cpf" class="form-control" required value="<%= cliente.cpf%>">
                <label for="endereco">Endereço do cliente</label>
                <input type="text" name="endereco" id="endereco" class="form-control" required value="<%= cliente.endereco%>">
                <br>
                <input type="hidden" name="id" id="id" value="<%= cliente.id %>">
                <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo editar o cliente <%= cliente.nome %>')">Alterar</button>
                <a href="/personagens">
                    <button type="button" class="btn btn-danger">Cancelar</button>
                </a>
            </form>
        </div>
    </div>
</div>


<%- include ('partials/footer.ejs') %>