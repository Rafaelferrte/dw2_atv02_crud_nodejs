
<%- include('partials/header.ejs') %>

<main class="conteudo pagina-categoria">
    <div class="formulario-container">
        <div class="formulario-header">
            <p class="subtitulo">Terra-média</p>
            <h1>Editar personagem</h1>
            <p>Atualize as informações deste personagem.</p>
        </div>

        <div class="formulario-body">
            <form class="formulario-editar" action="/personagens/alterar" method="POST">
                <div class="campo">
                    <label for="nome">Nome</label>
                    <input type="text" name="nome" id="nome" required value="<%= personagem.nome %>">
                </div>

                <div class="campo">
                    <label for="raca">Raça</label>
                    <input type="text" name="raca" id="raca" required value="<%= personagem.raca %>">
                </div>

                <div class="campo">
                    <label for="origem">Origem</label>
                    <input type="text" name="origem" id="origem" required value="<%= personagem.origem %>">
                </div>

                <div class="campo">
                    <label for="papel">Papel</label>
                    <input type="text" name="papel" id="papel" required value="<%= personagem.papel %>">
                </div>

                <input type="hidden" name="id" id="id" value="<%= personagem.id %>">

                <div class="botoes-formulario">
                    <button type="submit" class="btn-alterar"
                        onclick="return confirm('Deseja mesmo editar o personagem <%= personagem.nome %>')">
                        Alterar
                    </button>

                    <a href="/personagens" class="btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('partials/footer.ejs') %>
