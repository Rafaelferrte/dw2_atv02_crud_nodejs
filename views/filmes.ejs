<%- include("partials/header") %>

<section class="pagina-categoria">
    <div class="titulo-pagina">
        <p class="subtitulo">Do livro para as telas</p>
        <h1>Filmes</h1>
        <p>
            Conheça algumas das produções cinematográficas ambientadas
            na Terra-média.
        </p>
    </div>

    <div class="tabela-container">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Ano</th>
                    <th>Diretor</th>
                    <th>Duração</th>
                </tr>
            </thead>

            <tbody>
                <% filmes.forEach(function (filme) { %>
                    <tr>
                        <td><%= filme.titulo %></td>
                        <td><%= filme.ano %></td>
                        <td><%= filme.diretor %></td>
                        <td><%= filme.duracao %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</section>

<%- include("partials/footer") %>