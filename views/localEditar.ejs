
<%- include('partials/header.ejs') %>

<main class="conteudo pagina-categoria">
    <div class="formulario-container">
        <div class="formulario-header">
            <p class="subtitulo">Terra-média</p>
            <h1>Editar local</h1>
            <p>Atualize as informações deste local.</p>
        </div>

        <div class="formulario-body">
            <form class="formulario-editar" action="/locais/alterar" method="POST">
                <div class="campo">
                    <label for="local">Local</label>
                    <input type="text" name="local" id="local" required value="<%= local.local %>">
                </div>

                <div class="campo">
                    <label for="regiao">Região</label>
                    <input type="text" name="regiao" id="regiao" required value="<%= local.regiao %>">
                </div>

                <div class="campo">
                    <label for="habitantes">Habitantes</label>
                    <input type="text" name="habitantes" id="habitantes" required value="<%= local.habitantes %>">
                </div>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <input type="text" name="descricao" id="descricao" required value="<%= local.descricao %>">
                </div>

                <input type="hidden" name="id" id="id" value="<%= local.id %>">

                <div class="botoes-formulario">
                    <button type="submit" class="btn-alterar"
                        onclick="return confirm('Deseja mesmo editar o local <%= local.local %>')">
                        Alterar
                    </button>

                    <a href="/locais" class="btn-cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('partials/footer.ejs') %>
